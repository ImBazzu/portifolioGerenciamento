# Copie para ".env" na MESMA pasta do docker-compose.yml:
#   cp env.example .env && chmod 600 .env
# NUNCA faça commit do .env (confira o .gitignore).
#
# Gere cada segredo com:  openssl rand -hex 32
# (hex evita problemas com $ # " ' dentro do arquivo .env)
#
# ATENÇÃO: o MySQL só lê MYSQL_* / DB_USER / DB_PASSWORD quando o volume está
# vazio (primeiro "up"). Acerte tudo ANTES do primeiro "docker compose up".

DOMINIO=sectransportecjs.com.br
ACME_EMAIL=rob.hichert@gmail.com

MYSQL_ROOT_PASSWORD=
DB_BANCO=secretaria_transporte
DB_USER=secretaria
DB_PASSWORD=

# Segredo HMAC do JWT: use valor aleatório com 32+ bytes
JWT_SECRETS=
JWT_ASSINATURA=
